<?xml version='1.0' encoding='utf-8'?>
<widget id="com.yourname.vokalpro" version="1.0.0"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:cdv="http://cordova.apache.org/ns/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android">

  <name>VokalPro</name>
  <description>Dein persönlicher Vokabeltrainer – überall lernen</description>
  <author email="you@example.com">Dein Name</author>

  <content src="index.html" />
  <allow-navigation href="https://fonts.googleapis.com/*" />
  <allow-navigation href="https://fonts.gstatic.com/*" />
  <allow-navigation href="https://vision.googleapis.com/*" />
  <access origin="*" />

  <preference name="Orientation" value="portrait" />
  <preference name="android-minSdkVersion" value="26" />
  <preference name="android-targetSdkVersion" value="33" />
  <preference name="StatusBarOverlaysWebView" value="false" />
  <preference name="StatusBarBackgroundColor" value="#0B0918" />
  <preference name="StatusBarStyle" value="lightcontent" />
  <preference name="BackgroundColor" value="0xff0b0918" />
  <preference name="DisallowOverscroll" value="true" />
  <preference name="KeyboardDisplayRequiresUserAction" value="false" />
  <preference name="SplashScreenDelay" value="0" />
  <preference name="AutoHideSplashScreen" value="true" />
  <preference name="WebViewBounce" value="false" />

  <!-- Cordova Plugins -->
  <plugin name="cordova-plugin-camera" spec="^7.0.0" />
  <plugin name="cordova-plugin-statusbar" spec="^4.0.0" />
  <plugin name="cordova-plugin-keyboard" spec="^2.2.0" />
  <plugin name="cordova-plugin-vibration" spec="^3.1.1" />

  <!--
    VocabBridge: Native JS-Bridge fuer ForegroundService.
    Die Java-Dateien liegen in native/src/main/java/com/yourname/vokalpro/
    und werden im CI-Workflow in den Android-Build kopiert.
  -->
  <feature name="VocabBridge">
    <param name="android-package" value="com.yourname.vokalpro.VocabBridgePlugin" />
    <param name="onload" value="false" />
  </feature>

  <platform name="android">
    <allow-intent href="market:*" />

    <!-- Permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      ForegroundService + BootReceiver werden per config-file ins
      AndroidManifest eingetragen. Der CI-Workflow kopiert ausserdem
      die Java-Sourcen nach platforms/android/app/src/main/java/...
    -->
    <config-file target="AndroidManifest.xml" parent="/manifest/application">
      <service
        android:name="com.yourname.vokalpro.VocabForegroundService"
        android:foregroundServiceType="dataSync"
        android:exported="false"
        android:stopWithTask="false" />
      <receiver
        android:name="com.yourname.vokalpro.BootReceiver"
        android:enabled="true"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.BOOT_COMPLETED" />
          <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        </intent-filter>
      </receiver>
    </config-file>

    <icon src="res/icon.png" />
    <splash src="res/screen.png" />
  </platform>

</widget>
