<?xml version='1.0' encoding='utf-8'?>
<widget id="com.yourname.vokalpro" version="1.0.0"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:cdv="http://cordova.apache.org/ns/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android">

  <name>VokalPro</name>
  <description>Dein persönlicher Vokabeltrainer</description>
  <author email="you@example.com">Dein Name</author>

  <content src="index.html" />
  <allow-navigation href="https://fonts.googleapis.com/*" />
  <allow-navigation href="https://fonts.gstatic.com/*" />
  <allow-navigation href="https://vision.googleapis.com/*" />
  <access origin="*" />

  <preference name="Orientation" value="portrait" />
  <!-- Fix 1: targetSdkVersion muss >= 34 für cordova-android@13 -->
  <preference name="android-minSdkVersion" value="26" />
  <preference name="android-targetSdkVersion" value="34" />
  <preference name="android-compileSdkVersion" value="34" />
  <preference name="StatusBarOverlaysWebView" value="false" />
  <preference name="StatusBarBackgroundColor" value="#0B0918" />
  <preference name="StatusBarStyle" value="lightcontent" />
  <preference name="BackgroundColor" value="0xff0b0918" />
  <preference name="DisallowOverscroll" value="true" />
  <preference name="KeyboardDisplayRequiresUserAction" value="false" />
  <preference name="WebViewBounce" value="false" />
  <!-- Fix 2: <splash> Tag nicht mehr unterstützt – stattdessen preference -->
  <preference name="AndroidWindowSplashScreenAnimatedIcon" value="" />

  <!-- Cordova Plugins -->
  <plugin name="cordova-plugin-camera" spec="^7.0.0" />
  <plugin name="cordova-plugin-statusbar" spec="^4.0.0" />
  <plugin name="cordova-plugin-keyboard" spec="^2.2.0" />
  <plugin name="cordova-plugin-vibration" spec="^3.1.1" />

  <!-- VocabBridge: Native JS-Bridge für ForegroundService -->
  <feature name="VocabBridge">
    <param name="android-package" value="com.yourname.vokalpro.VocabBridgePlugin" />
    <param name="onload" value="false" />
  </feature>

  <platform name="android">
    <allow-intent href="market:*" />

    <!-- Fix 3: <icon> und <splash> ohne src-Pfad entfernt -->
    <!-- Icon kann später über res/icon.png ergänzt werden -->

    <!-- Permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ForegroundService + BootReceiver ins AndroidManifest eintragen -->
    <config-file target="AndroidManifest.xml" parent="/manifest/application">
      <service
        android:name="com.yourname.vokalpro.VocabForegroundService"
        android:foregroundServiceType="dataSync"
        android:exported="false"
        android:stopWithTask="false" />
      <receiver
        android:name="com.yourname.vokalpro.BootReceiver"
        android:enabled="true"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.BOOT_COMPLETED" />
          <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        </intent-filter>
      </receiver>
    </config-file>
  </platform>

</widget>
